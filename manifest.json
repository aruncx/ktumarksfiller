{
  "manifest_version": 3,
  "name": "KTU Marks Auto-Filler",
  "version": "1.1",
  "description": "Seamlessly upload and auto-fill student attendance and internal marks from Excel into the KTU portal.",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}